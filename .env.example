# Optional. Everything works without this file — the app falls back to the
# public endpoints listed in src/lib/chain.ts. Set one per chain only if you are
# running enough traffic to get rate-limited. RPC_URL alone still means Base.
RPC_URL_ROBINHOOD=https://rpc.mainnet.chain.robinhood.com
RPC_URL_BASE=https://mainnet.base.org
RPC_URL_XLAYER=https://rpc.xlayer.tech

# Invite-only access. Comma-separated sha256 hashes of the codes you issue —
# never the codes themselves, so a leaked config does not hand out access.
# Unset means the gate is OPEN, which is right locally and wrong in production.
#   node -e "console.log(require('crypto').createHash('sha256').update('your-code').digest('hex'))"
# Revoke an invitation by removing its hash; it takes effect immediately, including
# for anyone already holding the cookie.
# INVITE_CODE_HASHES=

# Demo mode. Set to 1 to populate the interface with sample balances and fills
# when no wallet is connected — for screenshots, walkthroughs and staging.
# Read at build time, so it must be set on the build, not the running server.
# Everything it renders is marked `sample` in the UI. Leave unset in production
# unless you intend to publish illustrative figures.
NEXT_PUBLIC_DEMO_MODE=0

# Local MCP trading (npm run mcp). Put this in .env.local, never in a deployed
# environment: it is read only by scripts/mcp.ts on your own machine, and lets
# Claude sign and send swaps from this wallet. Use a dedicated wallet holding
# only what you intend to trade. Leave unset for read-only tools.
# PATHIEL_PRIVATE_KEY=0x...
